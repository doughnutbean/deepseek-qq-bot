# ================== DeepSeek ==================
# 去 https://platform.deepseek.com/api_keys 创建
DEEPSEEK_API_KEY=sk-REPLACE_WITH_YOUR_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# 思考模式：off / low / high / max：QQ 聊天建议关掉或 low，又快又省
DEEPSEEK_THINKING=disabled
# 1 = 不调真实 API，只回显（测链路用）
DEEPSEEK_DRY_RUN=0

# 文件类配置：裸文件名会自动落到 data/；写绝对路径就按绝对路径。
# 例：MEMORY_DB=memory.db 等价于 data/memory.db（兼容旧 .env）。

# ================== NapCat / OneBot ==================
ONEBOT_WS_URL=ws://127.0.0.1:3001
ONEBOT_TOKEN=

# ================== 机器人 ==================
BOT_QQ=
# 掉线看门狗：每天几点主动重启 NapCat 刷新登录态
# （-1 = 只做掉线自动重启，不主动刷新；风控期建议 -1，别每天制造一次登录）
NAPCAT_WATCHDOG_REFRESH_HOUR=-1
# 被强制下线时推送到手机 + 电脑（留空 = 不推送）
# WxPusher 极简推送：扫官方文档里的二维码拿 SPT_ 开头的令牌，
# 手机和 Windows 客户端登录同一个账号即可同时收到。
KICK_NOTIFY_WXPUSHER_SPT=
# 主人 QQ：只有这个号私聊时，她才被允许改自己的签名/头像/昵称
OWNER_QQ=
# 人格文字放 persona.md（多行好维护），这一项只是兜底
BOT_PERSONA=（见 persona.md）
# @ 她算不算"点名"（true = 算，必回）
TRIGGER_AT=true
# 消息以这些词开头 = 点名（逗号分隔；空 = 不启用）。
# 是开头匹配、不是包含：「本鱼你觉得呢」算，「今天本鱼…」不算。
# 和 PROACTIVE_KEYWORDS 不是一回事：这里命中必回，关键词只是插话候选。
TRIGGER_PREFIX=
# 群白名单：填了之后只在这些群触发、落群语料、抽事实、记熟悉度；空 = 所有群。
# 2026-10-26 修过一个 bug：测试群曾漏进正式 group_log.db（显示 11 群，实际 6 群）。
GROUP_WHITELIST=
# 群里哪些号是"固定话术的机器人" / "别的大模型接入"，逗号隔开。
# 这部分认不准，人工维护：填 QQ 号，别填昵称。填了才会打【机器人】/【AI】标签。
ROBOT_QQS=
AI_QQS=
ALLOW_PRIVATE=true
MAX_HISTORY=12
RATE_LIMIT_SECONDS=1
# 休眠/掉线回连时，超过这么多秒的旧消息直接跳过（0 = 不检查）
STALE_MESSAGE_SECONDS=120
# 分句发：她自己换行的地方，拆成两条消息发（更像人）
ENABLE_SPLIT_MESSAGES=true
SPLIT_DELAY_MIN=0.4
SPLIT_DELAY_MAX=1.0
SPLIT_MAX_SEGMENTS=3
MAX_REPLY_CHARS=600

# ================== 联网搜索 ==================
# 走 DeepSeek 独立接口 /v1/tools/search，5 元 / 1000 次，搜不到结果不计费
ENABLE_SEARCH=true
# 事实闸门：本地判定「这是可查的事实问题」时，她开口之前先自己查一遍（0 token 判断）。
# 口径是「拿不准就先查」：查证问句、明确说「搜一下 / 查一下」都算；沾 B 站的话题
# 还会免费预搜站内（bili_search，本地接口，不吃这里的网页预算）。
# 关掉就退回老样子 —— 搜不搜由她自己决定，多数时候会直接说「不知道」。
SEARCH_GATE=true
# 一次预搜约 ¥0.006（搜索 5 厘 + 结果进 prompt）。上限只数**预搜**，且真花出去
# 才算：命中缓存、搜索失败、超时都不扣。0 = 这一档不封顶。主人说搜索费不用省，
# 所以默认比原来宽（原来是 20 / 80）。
SEARCH_GATE_HOURLY=60
SEARCH_GATE_DAILY=300
# 同一个问题查过就直接复用缓存，不再花那 5 厘。默认只复用半小时，更久的一律重搜；
# 时效性查询（最新/今天/价格/版本/天气/比分…）过了这个时间也会重新搜。0 = 每次都真搜。
SEARCH_REUSE_MINUTES=30

# ================== B站链接 ==================
# 群里有人贴 B 站视频（卡片或裸链）时，顺手查一份「标题/UP/时长/播放/简介」，
# 0 token、不下载视频、不看画面。她只是知道自己被发的是什么，别再回「你发的啥」。
# 关掉之后：卡片标题仍会进正文（纯本地解析），只是不再联网补 UP/时长这些。
ENABLE_BILI_CARD=true
# 查一个链接最多等几秒。超时/风控/失败一律当没查到，绝不影响这轮回复。
BILI_TIMEOUT=4.0
# 同一个视频查过一次留多久（分钟）。群里同一个链接会被反复贴，缓存能省掉重复请求。
BILI_CACHE_MINUTES=60
# 卡片长度上限（字）。正文每轮都发进 prompt，太长会挤掉人设和上下文。
BILI_CARD_MAX_CHARS=200
# 封面：查到视频后把封面图也发给她看一眼（vision 按图计费；封面图大小上限，MB）。
# 封面不算视频画面，prompt 里会明说。
ENABLE_BILI_COVER=true
BILI_COVER_MAX_MB=1.5
# 档案：官方 AI 总结 + 分段时间轴 + AI 字幕，落盘 7 天、后台跑、不挡回复。
# 需要填一个**小号**的 SESSDATA（浏览器登录后 F12 → Application → Cookies 里拿）。
# 不填也能跑：只是拿不到总结和字幕，卡片/封面照旧。
ENABLE_BILI_ARCHIVE=true
BILI_SESSDATA=
BILI_ARCHIVE_DIR=data/bili
BILI_ARCHIVE_DAYS=7
# 档案进 prompt 的字数上限（摘要 + 分段 + 字幕按时间采样后）
BILI_ARCHIVE_MAX_CHARS=700
# 热评 + 弹幕峰值（多 1~5 个请求，仍在后台跑）。风控紧或嫌吵就关掉。
ENABLE_BILI_EXTRAS=true
# 档案学到的内容写进知识库（本地 sqlite，0 token）：以后聊到同一个视频/UP 能想起来。
# 400 字上限，只放摘要/分段/热评/弹幕（不含字幕），TTL 默认 30 天。
ENABLE_BILI_KNOWLEDGE=true
BILI_KNOWLEDGE_DAYS=30
# 接口底座：单次超时（秒）/ 两次请求最小间隔（秒，防连打吃风控）/ 一次档案最多跑多久
BILI_API_TIMEOUT=6.0
BILI_RATE_SECONDS=1.0
BILI_ARCHIVE_TIMEOUT=25.0
# 一步到位：带链接那一轮最多同步等档案多久（秒）。0 = 只给卡片、档案留给后台，
# 下一句追问再补。网络快可以调到 15~20，嫌回复慢就调小。
BILI_SYNC_TIMEOUT=12
# 画面：被问「画面/长什么样/截图」时下载视频、按镜头抽 12 格拼一张图（默认关）。
# 十分钟 360p 约 20~40MB，抽完即删；单帧在 data/bili/frames 留 24 小时，给「03:10 那段」放大用。
# 格数 4~16：越多覆盖越全，但每格越小、字越难认。
ENABLE_BILI_FRAMES=false
BILI_FRAMES_TIMEOUT=180
BILI_FRAMES_CELLS=12
# 追问「03:10 那段」时用留底单帧拼一张放大图；关掉就只给整段分镜。
ENABLE_BILI_ZOOM=true
BILI_FRAMES_KEEP_HOURS=24

# ================== B站直播陪看 ==================
# 只读房间标题 + 公开弹幕，0 token；默认不看画面、不做 ASR、不登录、不发弹幕。
# 平时不用改这里：主人在聊天里说「看直播 12345」就会打开，房间号记在 data/prefs.json。
# 设为 true 但没有房间号也没有意义，启动时会按 prefs 里的房间重新判断。
ENABLE_BILI_LIVE=false
# 没开播时多久查一次（秒，15~300）。开播后会自动接弹幕，并每分钟复查一次状态。
BILI_LIVE_POLL_SECONDS=60
# 最多留多少条弹幕在内存里；给提示词的只有最近 BILI_LIVE_NOTE_LINES 条。
BILI_LIVE_MAX_DANMAKU=40
BILI_LIVE_NOTE_LINES=8
# 单次房间信息请求超时（秒）
BILI_LIVE_TIMEOUT=6.0
# 直播画面（默认关）：被问「主播在干嘛 / 画面呢」、或弹幕突然爆点时，拉 12 秒拼一张。
# 一次 1~2MB、出图 6~12 秒；群里谁问都能看，45 秒内复用同一张，不重复拉流。
ENABLE_LIVE_FRAMES=false
BILI_LIVE_FRAMES_SECONDS=12
BILI_LIVE_FRAMES_INTERVAL=1.33
# 滚动缓冲（默认开）：看直播时每 15 秒拉 2 秒，最近 2 分钟的帧只留内存；
# 问画面时直接拼，不用再等拉流。带宽约等于一直看一个低码率直播（~5%~13%）。
ENABLE_LIVE_BUFFER=true
BILI_LIVE_BUFFER_SECONDS=120
BILI_LIVE_BUFFER_INTERVAL=15
# 弹幕爆点：最近 10 秒够 BILI_LIVE_PEAK_MIN 条就自动抓一张，两次至少隔冷却秒数。
ENABLE_LIVE_PEAK=true
BILI_LIVE_PEAK_MIN=8
BILI_LIVE_PEAK_COOLDOWN=120
# 弹幕库：原始采样 + 高频词聚合；弹幕不会自动进群梗表，主人「直播梗入库」才写。
ENABLE_BILI_LIVE_MEMES=true
BILI_LIVE_DB=data/live_danmaku.db
# 原始采样留几天 / 高频词留几天 / 采样比例（热门房间一小时上万条，别全存）
BILI_LIVE_RAW_DAYS=7
BILI_LIVE_TERM_DAYS=30
BILI_LIVE_SAMPLE_RATE=0.1
# 进候选榜单的门槛：至少被刷几次、几个人刷（同一个人复读不算）
BILI_LIVE_MIN_HITS=3
BILI_LIVE_MIN_SPEAKERS=2
# 开播/下播记录：陪看轮询时顺手记，重启不丢，查「今天播了多久」用；只读本地库。
# 和弹幕库分开存，关掉直播梗也不影响开播记录。
BILI_LIVE_HISTORY_DB=data/live_history.db
BILI_LIVE_HISTORY_DAYS=180

# ================== 克里斯评论语料 ==================
# 独立 CLI 全量采集（不进聊天链路），用法见 docs/克里斯语料.md：
#   python tools/chris_cli.py plan  --mid 10000000
#   python tools/chris_cli.py crawl --mid 10000000 --limit 5
CHRIS_MID=10000000
CHRIS_DB=data/chris_comments.db
# 采集专用小号 cookie；空 = 用 BILI_SESSDATA
CHRIS_SESSDATA=
# BiliSpider 的建议频率：基础 1.5s + 0~1s 抖动；连续失败几次就停
CHRIS_RATE_SECONDS=1.5
CHRIS_STOP_412=5
# 笑话反馈：群里笑了/嫌老，先记 pending，下一轮挑笑话才折成权重（0 token）
ENABLE_CHRIS_FEEDBACK=true
CHRIS_FEEDBACK_FILE=data/chris_feedback.json

# ================== 看图 ==================
# deepseek-flash 支持 JPEG/PNG/GIF/WebP
ENABLE_VISION=true
# 图片记忆：同一张图只让模型看一次（省识图 token）
ENABLE_IMAGE_CACHE=true
IMAGE_CACHE_LIMIT=2000
MAX_IMAGES=4
MAX_IMAGE_MB=8
# 图和问题分两条发时（先甩图再问「这是你吗」，或者反过来）：
# 单独发来的图留这么久等下一句（0 = 不接）
IMAGE_CONTEXT_SECONDS=60
# 被叫到、手上还没图时多等这么久，别抢在图片前面答（0 = 不等）
IMAGE_WAIT_SECONDS=2.5

# ================== 合并转发 ==================
# 别人转发聊天记录时，先展开成文字再看；别人引用一份聊天记录再 @ 她，也会展开。
# 私聊一定展开；群里只在 @ / 触发词 / 主动插话开启时展开，仍走原来的门控，不强制回。
ENABLE_FORWARD=true
FORWARD_MAX_DEPTH=3
FORWARD_MAX_NODES=200
FORWARD_MAX_CHARS=8000
FORWARD_MAX_CALLS=8
# 放进群聊缓冲的预览长度（不是给模型的全文）
FORWARD_PREVIEW_CHARS=300

# ================== 好友申请 / 群邀请 ==================
# 默认关：不去点「同意」，申请会烂在 QQ 的「新朋友」里；
# 对方会收到一句委婉拒绝 + 原因，不把责任推给主人。
# 想开就在私聊里跟她说「可以加好友了」（存 prefs.json，重启也记得），或者这里改成 true。
FRIEND_AUTO_ACCEPT=false
# 开了之后一天最多批几个（防一觉醒来全是广告号）
FRIEND_DAILY_CAP=3
# 要多熟才批：0 生人 / 1 眼熟 / 2 聊过 / 3 熟人 / 4 老熟人（档位见 qqbot/familiar.py）
# 还要最近 30 天有互动、好感不为负（-0.5 也算负）
FRIEND_MIN_TIER=2
# 兜底拒绝话术。不同原因有内置委婉话术（刚认识 / 太久没见 / 好感为负 /
# 今天批够了 / 开关关着），这里只用于兜底；不要写「主人说了」。
FRIEND_REQUEST_REFUSAL=我们才刚认识嘛，再多聊两句吧。
# 她主动删人：只在私聊里删「正在骚扰她的那个人」，一天最多几个；删完会私聊报备主人
FRIEND_DELETE_DAILY=1
FRIEND_FILE=data/friends.json
# 有人私聊拉她进别的群时的固定拒绝话术（只有主人邀请才会真的进群）
GROUP_INVITE_REFUSAL=主人说了，不加群，别发了。
# 她自己拉黑人（私聊）：纯本地判断广告/骚扰/冒充主人，先警告三次，第四次才拉黑。
# 关掉之后她只认主人的「别理他」；聊天里说「别自动拉黑」/「打开自动拉黑」也能切。
AUTO_BAN_ENABLED=true
AUTO_BAN_WARNINGS=3
# 警告的保质期（天）：太久以前的旧账不往一块儿算
AUTO_BAN_STRIKE_DAYS=7
# 图片审查：文字本地就能判，图看不见 —— 只能用一次极短的看图调用（同一张图只判一次）。
# 这是自动拉黑里唯一花钱的地方；关掉就完全不判图。要 ENABLE_VISION=true 才生效。
AUTO_BAN_VISION=true
AUTO_BAN_MAX_IMAGES=2

# ================== 表情包 ==================
# 图在 stickers/<情绪>/ 目录里，想换成自己的图直接丢进去
ENABLE_STICKER=true
# 逐图语义索引：每轮按对话检索几张候选交给模型（写 [表情:#编号]）。
# 需要本地 embedding（ENABLE_SEMANTIC）；关掉就退回按标签随机挑。
ENABLE_STICKER_INDEX=true
# 每次给几张候选（0 = 不给菜单）
STICKER_CANDIDATES=6
# 从群里捡表情包：只收「主角是她」的图，走完整入库流程（去重/判定/注解/索引）
ENABLE_STICKER_STEAL=true
# 每天最多收几张（0 = 关）、两次至少隔几分钟、原图上限 MB
STICKER_STEAL_DAILY=3
STICKER_STEAL_MIN_MINUTES=60
STICKER_STEAL_MAX_MB=3
# 主人点名「偷这个」/「人工收图」时的上限（QQ 动图表情 3~8MB 很常见；
# 后台自动捡图仍按上面那条挡）
STICKER_STEAL_MANUAL_MAX_MB=10
# 每天最多做几次「是不是她」的视觉判定（控制花销）
STICKER_STEAL_CHECKS=30
# 本地颜色粗筛：蓝/黑白比例明显不像她的，先不看（主人手动「偷这个」不受限）
STICKER_STEAL_COLOR_FILTER=true
# 群友一起换掉有水印的表情包：引用旧图+新图，本地相似度通过才换
ENABLE_STICKER_REPLACE=true
# 每个群友每天最多换几张（0 = 不限；主人不计数）
STICKER_REPLACE_DAILY=3
STICKER_REPLACE_MAX_MB=3

# ================== 生气的设定 ==================
# 同一件事被反复问，她自己会烦；烦到冷战就真的不回（0 token 硬拒）。
# 怒气按人记、按话题记，具体分档见 qqbot/mood.py 顶部。
ENABLE_MOOD=true
MOOD_FILE=data/mood.json
MOOD_REPEAT_DELTA=22
MOOD_TRIGGER_DELTA=32
MOOD_DECAY_PER_MIN=2.5
MOOD_WINDOW_MINUTES=15
MOOD_SILENCE_CHANCE=0.5
MOOD_TRIGGER_WORDS=人机,机器人,复读机,AI味,换模型,什么模型,什么版本,掉线,你回来了,终于活了

# ================== 熟悉度 / 好感度 ==================
# 熟悉度：认识多久（0~100，只涨不跌）。独立于群聊语料的日聚合：
# group_log 有 20 万行上限、会删最旧，但熟悉度不受影响。
FAMILIAR_DB=data/familiar.db
FAMILIAR_CACHE_SECONDS=60
# 超过这么多天没直接说话，提示里不再按熟人口气（不改分数/档位）
FAMILIAR_STALE_DAYS=30
# 要不要把熟悉度/好感度提示进动态上下文（不塞 system prompt）
ENABLE_FAMILIAR_NOTE=true
# 好感度：最近怎么相处（-30~+30，会升会降）
ENABLE_AFFECTION=true
AFFECTION_FILE=data/affection.json
# 每日免费额度：前 5 点全额；超过后每 3 点衰减一半（0.5 → 0.25 → …），
# 没有硬性日上限。负面前 10 点全额，之后同样衰减。
AFFECTION_FREE_GAIN=5
AFFECTION_FREE_LOSS=10
AFFECTION_FATIGUE_STEP=3
AFFECTION_FATIGUE_FACTOR=0.5
# 疲劳最低折扣：再刷也还能涨，只是很慢
AFFECTION_MIN_MULTIPLIER=0.05
# 总分硬护栏：-30 ~ +30；到顶不再涨
AFFECTION_SCORE_MAX=30
# 多少天没有直接互动，向 0 靠 1 点
AFFECTION_DECAY_DAYS=14

# ================== 长期记忆 ==================
# 对话落 SQLite，重启不忘、跨天能想起旧事
ENABLE_MEMORY=true
MEMORY_DB=data/memory.db
# 长期记忆按什么划分：user = 按人（私聊/群聊共享），session = 按会话
# 遗忘曲线：短期记忆每天衰减多少（0.08 ≈ 半衰期 9 天）
MEMORY_FORGET_RATE=0.08
# 低于这个强度就算忘了，不再被召回
MEMORY_FORGET_THRESHOLD=0.15
# 被想起这么多次之后，短期记忆转成长期
MEMORY_PROMOTE_HITS=3
# 转长期的门槛：两次"想起"至少隔几小时（同一个晚上聊十遍只算一次）
MEMORY_PROMOTE_MIN_GAP_HOURS=12
# 关键词重合度门槛（0~1）：只是"语义有点像"不算又提起一次
MEMORY_PROMOTE_MIN_SCORE=0.5
# 内容至少多少字（去掉「【群友】昵称：」前缀后）；寒暄和问句再长也不算
MEMORY_PROMOTE_MIN_CHARS=12

MEMORY_SCOPE=user
# 每次最多回溯几条旧事（4 条关键词 + 1 条语义，第 4 条相关度和前三条基本持平）
RECALL_LIMIT=5
# 普通聊天至少给语义留几条：关键词再准也可能"字面命中、答非所问"
RECALL_SEMANTIC_FLOOR=1
# 关键词重合度阈值（百分比），越低越容易"想起"
RECALL_MIN_SCORE=25
# 回忆里最多带几条她自己的旧回复（0 = 只回忆别人说的）。
# 她越聊越像自己是真的：召回自己的口头禅 → 下一句照着说 → 再被召回。
RECALL_SELF_MAX=1
# 记忆题（「你还记得…」「我上次说的…」）：本地识别后多取几条、看更长的上下文。
# 这类问题不是在问世界真相，是在问"你记得什么"，值得多花一点 token。
MEMORY_QUESTION_RECALL=6
MEMORY_QUESTION_TURN_LIMIT=48
MEMORY_QUESTION_CONTEXT_LINES=20
# 记忆题时从 group_log 补最近群消息（包括她当时没接的；0 = 不补）
MEMORY_GROUP_LOG_DAYS=7
MEMORY_GROUP_LOG_LIMIT=6
# 每轮告诉她"你的记忆到哪为止、关于这个人有多少条事实"
MEMORY_STATUS_NOTE=true
# 给模型一个 remember_fact 工具：群聊/私聊都能记"关于当前说话人"的事实
ENABLE_MEMORY_TOOL=true
# 搜索结果的缓存天数：下次同类问题先提"上次查到过"（0 = 不缓存）
KNOWLEDGE_TTL_DAYS=7

# ================== 语义召回 ==================
# 本地 embedding 模型，补关键词的短板（"我下周出门" ≈ "要去杭州出差"）
# 首次要下载模型：python tools/fetch_model.py
ENABLE_SEMANTIC=true
EMBED_MODEL=models/bge-small-zh-v1.5
# z-score 门控：往高调更严格，1.2~1.6 比较合适
SEMANTIC_Z=1.4
# 绝对余弦下限，防止全是低分候选时硬凑
SEMANTIC_COS=0.35
# 语义命中也算"最近又碰到过"：给一点强度、把 last_access 往前挪。
# 不然一条天天被语义想起的事，24 天后还是会按遗忘曲线消失（0 = 不刷新）。
SEMANTIC_RECALL_BUMP=0.05
# 语义召回一次最多看多少条候选：群聊很活跃时 600 条可能只覆盖几小时，
# 3000 条一般能覆盖一两天（默认 3000）
SEMANTIC_CANDIDATES=3000

# ================== 改口游戏 ==================
# 群友想让她改口时，先装傻/嘴硬，再一步一步慢慢松口，最后把成就感给他们。
# 只演群里的梗/外号/玩笑，不碰主人定的事、她的设定、别人的隐私。
ENABLE_CONCESSION=true
CONCESSION_FILE=data/concession.json
# 多久没再提就忘掉这场戏
CONCESSION_TTL_SECONDS=1800
# 同一个人两次开口至少隔多久才算"又逼了一次"
CONCESSION_MIN_GAP_SECONDS=15
# 两次"让一步"至少隔多久：保证是缓慢的，不是一句话就投降
CONCESSION_STAGE_SECONDS=20

# ================== 上线问候 ==================
# 启动完成后让模型按人设和当前时间写一句，发到所有群（一次模型调用）
ENABLE_STARTUP_GREETING=true

# ================== 好友上线通知（可选） ==================
# 好友在私聊里说「打开上线通知」后，机器人每次上线会私聊告诉他一句。
# 只发上线、不发下线；默认关（订阅名单空），只有 QQ 好友能自己开；
# 主人和机器人自己不订阅。风控考虑：只在停机够久后发、每人每天最多 1 条、
# 夜间不发、每次最多 20 人。
PRESENCE_DM_ENABLED=true
# 连上 NapCat 后先稳定这么久再发，避免 bot_loop 崩溃循环时连着吵人
PRESENCE_DM_STABLE_SECONDS=60
# 停机不到这么久（分钟）不发，热重启不吵
PRESENCE_DM_MIN_DOWNTIME_MINUTES=30
# 同一个人两次之间至少隔多久（分钟），以及每天最多几条
PRESENCE_DM_COOLDOWN_MINUTES=360
PRESENCE_DM_DAILY_CAP=1
# 这个时段内不发（北京时间，HH:MM-HH:MM；留空 = 不静音）
PRESENCE_DM_QUIET_HOURS=23:00-08:00
# 一次最多发给多少个好友
PRESENCE_DM_MAX_RECIPIENTS=20
PRESENCE_DM_STATE_FILE=data/presence_dm_state.json

# ================== 上线补收私聊 ==================
# 每次启动/重连稳定后，检查最近的私聊：最后一条不是她说的，就说明这段私聊
# 她没接上（正常情况下所有私聊都以她的话结尾），把漏掉的那串合成一轮补回来。
# 不看 checkpoint、不按 message_id 记账：回完最后一条就变成她的，天然去重；
# 发送失败就留着下次再补。
ENABLE_CATCHUP_DM=true
# 只补最近这么久以内的；超过就忽略，不对几天前的消息突然诈尸
CATCHUP_MAX_AGE_HOURS=24
# 连上后先稳定这么久（秒）再扫，避开启动时的连接抖动
CATCHUP_SETTLE_SECONDS=20
# 一次最多检查多少个联系人、最多真回几个（其余下次再补；0 = 不封顶）
CATCHUP_MAX_CONTACTS=20
CATCHUP_MAX_REPLIES=10
# 拉历史时一次拉多少条
CATCHUP_HISTORY_COUNT=100
# 两个人之间隔多久（秒），别一口气刷屏
CATCHUP_REPLY_SPACING_SECONDS=2
# 漏了不到这么多分钟：按正常语气接（仍会提一句刚卡了一下）；
# 超过就要求她先说明「掉线了才看见」
CATCHUP_APOLOGY_MINUTES=10
# 演练：只在日志里列「本来会补哪些」，不真发
CATCHUP_DRY_RUN=false

# ================== 群聊主动插话 ==================
# 风控规避模式：换号/被提示风险时先开这个。
# 也可以聊天里说「打开风控模式 / 关闭风控模式」；开关存 data/prefs.json，重启记得。
# 开：群聊收到消息后至少隔 1 秒再回、每分钟最多 10 条、两条间隔 1.2 秒；
#     频率不够时排队不截断，积压超 3 条不再接并说「回不过来了」；关掉模式排队即停；
#     主动插话/跟着复读/答完补一句/上线问候/推送/说说全停，不@人、不贴图、不拆条。
ENABLE_RISK_MODE=false
# 开着的话，群里没 @ 她、但聊到相关内容时她会自己接一句
ENABLE_PROACTIVE=false
# 命中这些词就进入候选（逗号分隔，不区分大小写）
# 注意别放太短的词，比如 ai，会误中 email / wait 之类
# 关键词是子串匹配，语气词/连接词会被自动丢掉（见 qqbot/stopwords.py）
# 至少几个字才算关键词（中文单字太容易在别的词里出现）
PROACTIVE_KEYWORD_MIN_LEN=2

PROACTIVE_KEYWORDS=鲸鱼,deepseek,大肥鱼,deepseek娘,模型,本鱼
# 非关键词消息被抽中考虑的概率，越小越安静
PROACTIVE_CHANCE=0.03
# 同一个群两次主动说话的最小间隔（秒）
# 有人喊「闭嘴」时安静多少分钟（0 = 关闭）
QUIET_MINUTES=5
# 「闭嘴」只认冲她说的：@ 她 / 引用她 / 正在跟她聊，或者句子里带了这些叫法。
# 只放"别人怎么叫她"：本鱼是她的自称，不是叫法，别放进来。
QUIET_SELF_NAMES=大肥鱼,肥鱼,鲸鱼,鲸鱼娘

PROACTIVE_COOLDOWN=120
# 每小时最多主动说几次
PROACTIVE_HOURLY_CAP=6

# 按人跟进窗口：她回了谁，就给谁开一个窗口。
# 窗口内只有"同一个人、同一件事"才继续接；换话题/去跟别人说话就关窗。
# 多人同时跟她说话，各开各的窗口，互不覆盖。
PROACTIVE_FOLLOWUP_SECONDS=90
# 一条窗口里最多回几条（含开窗那条；0 = 不限制）
PROACTIVE_FOLLOWUP_MAX_REPLIES=6
# 她刚回完的同一个人，多少秒内下一句算"即时接话"（不要求话题重合）
PROACTIVE_FOLLOWUP_IMMEDIATE_SECONDS=30
# 两条回复之间的最小间隔（秒），防止连珠炮
PROACTIVE_FOLLOWUP_GAP=5

# 旧对话链参数：P1 之后不再使用，保留只为兼容旧 .env；可以整段删掉。
PROACTIVE_CHAIN_SECONDS=300
PROACTIVE_CHAIN_MAX=12
PROACTIVE_CHAIN_TURNS=24
PROACTIVE_CHAIN_JUDGE_MAX=18
PROACTIVE_CHAIN_HARD_SECONDS=900
PROACTIVE_CHAIN_MEMBER_SECONDS=120
PROACTIVE_CHAIN_FOLLOWUP_SECONDS=20
PROACTIVE_CHAIN_JOIN_TOPIC=false
PROACTIVE_CHAIN_GAP=5
PROACTIVE_CHAIN_STRIKE_MAX=2
# 消抖：收到消息后等这么久，把期间的消息合成一回合再判断（防止接半句话）。
# 不再按句尾加倍（以前没标点会 ×1.8 → 4.5 秒，中文群聊几乎每条都吃满）。
# 喊她名字（QUIET_SELF_NAMES）时走 @ 的快通道，按 MERGE_WINDOW_SECONDS 算。
PROACTIVE_DEBOUNCE=1.2
# 群聊插话批次最多等多久（0 = 不封顶）；和私聊 MERGE_CAP_SECONDS 独立
PROACTIVE_MERGE_CAP_SECONDS=8

# 被 @ 时补多少群聊上下文：最近几条、只取多少秒以内的（0 = 关掉）
GROUP_CONTEXT_LINES=8
GROUP_CONTEXT_SECONDS=600

# QQ 空间（让她能发说说，只有主人私聊时可用）
ENABLE_QZONE=true
QZONE_PRIVATE=0
# 发之前先私信给主人过一遍，确认了才发
QZONE_REQUIRE_APPROVAL=true
# 发说说的频率闸
QZONE_DAILY_LIMIT=2
QZONE_COOLDOWN_MINUTES=60
# 免打扰时段，留空表示不限制；支持跨零点，多段用逗号隔开
QZONE_QUIET_HOURS=00:00-08:00
# 让她自己想起来发说说：每天一次左右，从当天的聊天里挑件事写
ENABLE_QZONE_AUTO=false
# 只在晚上"想起来"（留空 = 全天）
QZONE_AUTO_WINDOW=18:00-23:00
# 两次之间隔多久（小时，随机取区间）
QZONE_AUTO_MIN_HOURS=20
QZONE_AUTO_MAX_HOURS=28
# 今天至少聊过几条，才值得写
QZONE_AUTO_MIN_TURNS=4
# 多久检查一次（分钟）
QZONE_AUTO_CHECK_MINUTES=15
# 别人在她自己发的说说下面评论，她自己去回一句。
# 公开可见，默认关；打开前建议先用 QZONE_PRIVATE=1 试几条。
ENABLE_QZONE_REPLY=false
# 多久看一次评论（分钟）
QZONE_REPLY_CHECK_MINUTES=30
# 一天最多回几条；两条之间至少隔多久（分钟）；同一个人多久内只回一次（小时）
QZONE_REPLY_DAILY_LIMIT=3
QZONE_REPLY_COOLDOWN_MINUTES=10
QZONE_REPLY_PER_PERSON_HOURS=6
# 只看最近几条说说的评论；超过多少小时的旧评论不补回
QZONE_REPLY_MAX_POSTS=2
QZONE_REPLY_MAX_AGE_HOURS=48
# 免打扰时段，留空 = 不限制
QZONE_REPLY_QUIET_HOURS=00:00-08:00
# 这些 QQ 号评论了也不回（逗号分隔；留空 = 谁都回）
QZONE_REPLY_IGNORE_UINS=
# 回完要不要私聊告诉主人
QZONE_REPLY_NOTIFY_OWNER=false
# 响应档位：0 只回@和触发词 / 1 +关键词 / 2 +3%随机 / 3 +8%随机
# 设成 -1 就忽略这个字段，沿用下面的 PROACTIVE_* 细项
RESPONSE_TIER=2

# 花销统计（单价：元 / 百万 token，按你实际用的模型改）
ENABLE_USAGE=true
PRICE_INPUT=1.0
PRICE_OUTPUT=4.0
PRICE_CACHED=0.02
# 高峰时段价格 = 空闲价 × 这个倍率（官方是 2 倍）
PRICE_PEAK_MULTIPLIER=2.0
# 联网搜索 / 抓网页：元 / 次成功请求（官方 5 元 / 1000 次，搜不到不计费）
PRICE_SEARCH_CALL=0.005
PRICE_FETCH_CALL=0.005
# 账户余额观测：每 N 分钟调一次 /user/balance，按余额下降记「账户实扣」。
# 账户实扣是**整个账户**的（DSH/其他客户端也在花），和本机 usage.db 分开显示。
ENABLE_BALANCE_WATCH=true
BALANCE_POLL_MINUTES=10
# 余额接口地址；留空 = DEEPSEEK_BASE_URL + /user/balance。
# 中转站不支持就填自己的，但只填你信任的地址 —— 这里会带上 DEEPSEEK_API_KEY。
BALANCE_API_URL=
# 主人私聊里，每轮告诉她今天本机花了多少、账户还剩多少（只进动态上下文，
# 不破前缀缓存；群聊和别人私聊不带，账户余额只对主人说）。
MONEY_AWARENESS=true
# 每日账本：每天中午把昨天的花销私聊发给主人（需要 OWNER_QQ）
ENABLE_DAILY_REPORT=true
# 几点发（12:00 / 中午12点 都认）
DAILY_REPORT_AT=12:00
# 错过整点多久内还补发（小时）；0 = 过一分钟就等明天
DAILY_REPORT_CATCHUP_HOURS=8
# 演练：只在日志里打印，不真发
DAILY_REPORT_DRY_RUN=false
# 她自己的日记：每天睡前把当天的事写成一篇，只存 data/diary.db；
# 只有主人私聊能翻（「日记」），群里一个字都不给。
ENABLE_DIARY=true
# 几点写（23:30 / 23：30 都认）；写的是「当前这一天」
DIARY_AT=23:30
# 错过之后多久内还补写（小时）；0 = 过了那一分钟就等明天
DIARY_CATCHUP_HOURS=12
# 写完私聊告诉主人一声（只报标题和一句开头，不贴全文）
DIARY_NOTIFY=true
# 当天至少多少条对话素材才值得写；不够就记一笔 skipped，不花模型钱
DIARY_MIN_TURNS=6
# 一次最多给模型看多少条片段（多了会写成流水账）
DIARY_MAX_LINES=50
# 回复窗口：同一个人连发几条时等这么久合成一次回（0 = 逐条秒回）
# 群聊里不同人的 @ 各自成批，不会合成一轮；0.8 秒是延迟和连发体验的折中
MERGE_WINDOW_SECONDS=0.8
# 发了卡片/链接之后多等这么久：后面多半还有一句「你看看这个」，
# 不等就会先回卡片、再回留言（0 = 不等）
LINK_WAIT_SECONDS=2.5
# 答完再补一句：查完东西/答完问题后，隔一会儿往前推一句
ENABLE_FOLLOWUP=true
FOLLOWUP_DELAY_MIN=90
FOLLOWUP_DELAY_MAX=240
FOLLOWUP_COOLDOWN_MINUTES=30

# 主动私信：她偶尔先开口找你
PROACTIVE_DM=false
# 多久醒一次看要不要说话（分钟，随机区间）
DM_WAKE_MIN=15
DM_WAKE_MAX=30
# 冷场多久才值得找他 / 同一个人两次至少隔多久
DM_IDLE_MINUTES=30
DM_COOLDOWN_MINUTES=120
DM_QUIET_HOURS=00:00-07:00
DM_DAILY_CAP=3
# 只写日志不真发（想先观察语气就打开）
DM_DRY_RUN=false
# 上次主动提的要求没回，隔几小时可以再提一次（0 = 永不追问）
DM_FOLLOWUP_HOURS=0
# 有事真的私聊主人：要主人拍板的事、有人说了关于主人的消息、有人找主人有事。
# 调 ask_owner / relay_owner 时会真发一条私信（不是只在群里说「去问问主人」）；
# 主人回话后，tell_original 把答复真的转回原来的群/人。
# 问过什么、还没回、谁在等答复，都存在这个文件里。
OWNER_ASK_FILE=data/owner_ask.json
# 群消息全量落库（风格学习的语料来源；只存文字，本机）
ENABLE_GROUP_LOG=true
GROUP_LOG_DB=data/group_log.db
# ================== 群名册 / @ 人 ==================
# 名册：谁是什么身份（群主/管理员/群友）、群头衔、群等级。
# 注意：说话人的身份来自消息事件自带的 sender.role，**0 调用**；
# 只有群头衔和"群主/管理员完整名单"才要拉一次 get_group_member_list。
ROSTER_DB=data/roster.db
# 拉一次全群成员之后缓存多久（秒）；过期了在后台重拉，不拖慢回消息。
# 每条群消息都会检查一次（点名关着也拉）；TTL 只看整群拉取时间，不看成员行。
ROSTER_TTL_SECONDS=1800
# 点名（她 @ 人）：默认关。开了也只在"不点名会被当成在回别人"时才点。
# 聊天里也能开关：可以@人了 / 别@人了
ENABLE_AT=false
# 开了 @ 之后，@ 谁由谁定：true = 模型自己挑（现状）；
# false = 不让模型挑，只在「有人 @/引用她」时点回那个人。
# 聊天里也能开关：让她自己@ / 别让她自己@
ENABLE_AT_MODEL_CHOICE=true
AT_STATE_FILE=data/at_state.json
# 群友自己的权限状态：个人免打扰、称呼偏好、别记我。
# 和主人的 prefs.json 分开：主人「恢复正常」不会清掉群友的「别记我」。
MEMBER_STATE_FILE=data/member_state.json
# 同一个群两次 @ 至少隔多久（秒）
AT_GROUP_COOLDOWN=300
# 同一个群每小时最多点几次
AT_GROUP_HOURLY_CAP=3
# 同一个人两次被点至少隔多久（秒）/ 每天最多几次
AT_PERSON_COOLDOWN=1800
AT_PERSON_DAILY_CAP=8
# 他得在这么久以内说过话才算在场（@ 一个不在场的人＝纯骚扰）
AT_PRESENT_SECONDS=300
# 点了没回，这个人多久之内不再点（防追命连环 @；0 = 关掉这条）
AT_MISS_IGNORE_HOURS=24
# 第一次见到这个群之后多久内不点名（先认认人）
AT_WARMUP_HOURS=6
# 风格学习注入开关：默认关，先看 python tools/style_learn.py analyze 再决定
ENABLE_STYLE_LEARNING=false
# 群风格统计画像（和上面的接话对不同：只统计句长/标点/节奏/口头语）
# 默认关；先 python tools/style_profile.py 看画像，确认不像报表再开
ENABLE_GROUP_STYLE=false
GROUP_STYLE_ADOPT=观察为主
GROUP_STYLE_REFRESH_MINUTES=30
GROUP_STYLE_SAMPLE=400
GROUP_STYLE_MIN_SAMPLE=30
GROUP_STYLE_MAX_CHARS=300
GROUP_STYLE_INCLUDE_WORDS=true
# 群语料理解层（默认关）：从本群历史里捞相关旧消息，只当背景，不改人设/口音。
# 先建索引：python tools/corpus_index.py build
# 先看召回：python tools/corpus_index.py search 群号 "一句话"
ENABLE_CORPUS_RECALL=false
CORPUS_INDEX_DB=data/corpus_index.db
# 索引用哪个 embedding；空 = 跟 EMBED_MODEL 一样。
# 微调模型必须先过塌陷检查（随机消息余弦中位数 < 0.5），见
# docs/理解层与embedding训练.md；2026-10-26 第一轮配方不可用，保持留空。
CORPUS_EMBED_MODEL=
CORPUS_RECALL_LIMIT=3
CORPUS_RECALL_DAYS=30
CORPUS_RECALL_MAX_CHARS=260
CORPUS_RECALL_MIN_SCORE=0.36
# 没有关键词命中、只靠语义时的余弦门槛；短句余弦偏高，默认更严
CORPUS_RECALL_SEMANTIC_ONLY=0.68
CORPUS_RECALL_EXCLUDE_MINUTES=10
# 索引增量同步：启动补一次 + 每 N 分钟把 group_log 新消息编码进索引；不重建全量。
# 0 = 不跑定时（只保留启动那次）；ENABLE_CORPUS_SYNC=false 则完全不动索引。
ENABLE_CORPUS_SYNC=true
CORPUS_SYNC_ON_START=true
CORPUS_SYNC_MINUTES=15
# 启动补完增量后，terms_stale 时只重算词表（约 1-2 秒，不加载模型）
CORPUS_TERMS_REFRESH_ON_START=true
# 热梗知识库：每天抓贴吧热议 + B站热门，触发词命中时才递小抄
ENABLE_HOT_TRENDS=true
HOT_TRENDS_HOUR=6
HOT_TRENDS_CHECK_MINUTES=15
HOT_TRENDS_KEEP_DAYS=7
HOT_TRENDS_MAX_TOPICS=300
HOT_TRENDS_MAX_CHARS=480
HOT_TRENDS_TRIGGER_WORDS=热搜,热梗,什么梗,最近火,最近流行,最近的梗,网上都在说,新鲜事,新梗,吃瓜,出什么事了,发生什么了,out了
# 抓完之后花一次模型调用，给每条热点写一句「这是什么梗、为什么火」
# （几分钱/天；不确定的会写「不清楚」，不会编）
ENABLE_TRENDS_EXPLAIN=true
TRENDS_EXPLAIN_COUNT=8
# 跟着群友复读：同一短串被多人短时间复读时，她也接一次（严格限流）
ENABLE_REPEAT_ALONG=true
REPEAT_ALONG_MIN_PEOPLE=3
REPEAT_ALONG_MIN_REPEATS=3
REPEAT_ALONG_WINDOW_SECONDS=30
REPEAT_ALONG_COOLDOWN_SECONDS=300
REPEAT_ALONG_MAX_CHARS=24
REPEAT_ALONG_PER_HOUR=6
# 群里的梗：从群日志统计「复读」，0 token；跨群都在用的会升级成通用说法
ENABLE_MEMES=true
# 聊天里模型搜到「可能是梗」时收结构化候选（不注入，等主人确认）
ENABLE_CHAT_MEME_CAPTURE=true
MEMES_KEEP_DAYS=30
MEMES_MAX_PER_GROUP=60
MEMES_MAX_CHARS=360
# 群共识站住（跨天/多人/多次）才搜一次，确认「到底是不是梗」；验过就不再花钱
ENABLE_MEME_VERIFY=true
MEME_VERIFY_PER_DAY=2
MEME_VERIFY_PER_RUN=1
MEME_VERIFY_COUNT=8
MEME_VERIFY_MIN_DAYS=3
MEME_VERIFY_MIN_SPEAKERS=5
MEME_VERIFY_MIN_HITS=8
# 网络梗：没见过的短词先问群友，确认是梗后再搜一次入库（进 global，留一年）
ENABLE_MEME_ASK=true
MEME_ASK_TTL_MINUTES=120
MEME_ASK_COOLDOWN_MINUTES=10
MEME_ASK_PER_DAY=5
# 记梗前的待确认：主人发「记梗 X」→ 查一次 → 等「入库 / 不入库」
MEME_INTAKE_FILE=data/meme_intake.json
MEME_INTAKE_TTL_MINUTES=120
MEMES_WEB_KEEP_DAYS=365
# 写法归一：缩写/换字（f8fq、鱼八分钱）→ 正词；缩写按拼音骨架自动认，这张表只记骨架认不出的
MEME_ALIASES_FILE=data/meme_aliases.json
# 通用梗百科：只读本地 6668 条词库；问梗给意思+用法，平时提到也给用法
# 词库不含任何用户数据；更新跑 python tools/meme_wiki.py download
ENABLE_MEME_WIKI=true
MEME_WIKI_DB=data/meme_wiki.db
MEME_WIKI_MAX_CHARS=220
# 平时聊天提到梗时，也提示“通常怎么用”（不是释义）；关掉就只回答问梗
MEME_WIKI_MENTION=true
# 同一个群同一个梗，多少分钟内不重复提示
MEME_WIKI_COOLDOWN_MINUTES=10
# 峰谷时段：DeepSeek 现行规则 —— 工作日 9-12、14-18 为高峰，其余（含周末/节假日）空闲
# 高峰收着省钱，空闲放开一点
ENABLE_PRICETIME_TIER=true
PRICETIME_PEAK_WINDOWS=09:00-12:00,14:00-18:00
# 2026 官方放假安排已内置；2027 年及以后可在这里追加（如 2027-10-01），逗号分隔
PRICETIME_HOLIDAYS=
PRICETIME_PEAK_TIER=0
PRICETIME_OFFPEAK_TIER=1

# ---- B站生活（她自己的小号；可选）----
# 开了之后，她会按自己的兴趣在首页/站内刷视频，留下生活记忆，聊天时偶尔提一句。
# 和上面的 BILI_SESSDATA 分开：换号/换口味不会影响群里的链接档案。
ENABLE_BILI_LIFE=false
BILI_LIFE_SESSDATA=
# 写操作（点赞/收藏/关注/评论）必须填 Cookie 里的 bili_jct，否则只读。
BILI_LIFE_JCT=
BILI_LIFE_DIR=data/bili_life
BILI_LIFE_WINDOW_START=10
BILI_LIFE_WINDOW_END=23
BILI_LIFE_DAILY_RUNS=10
BILI_LIFE_DAILY_PICKS=30
BILI_LIFE_MAX_ARCHIVES=3
# 她自己决定这轮搜哪几个词；这两个是硬上限，不是固定搜索词
BILI_LIFE_SEARCHES_PER_RUN=3
BILI_LIFE_DAILY_SEARCHES=30
BILI_LIFE_MIN_GAP_HOURS=1
# 群里安静多少分钟后可以提前刷一轮
BILI_LIFE_BORED_MINUTES=45
# 看见画面：复用聊天里的抽帧（ENABLE_BILI_FRAMES 必须也开）；模型决定要不要看
BILI_LIFE_VISION=true
BILI_LIFE_VISION_DAILY=10
BILI_LIFE_VISION_MAX_VIDEOS=1
BILI_LIFE_VISION_MAX_GRIDS=3
BILI_LIFE_MIN_VIEWS=1000
# 短视频优先：超过 20 分钟不进候选；自动看画面也只看 20 分钟内
BILI_LIFE_MAX_DURATION=1200
BILI_LIFE_VISION_MAX_DURATION=1200
BILI_LIFE_TOPICS=鲸鱼,白饭,AI,美食
BILI_LIFE_INTERACTIONS=false
BILI_LIFE_COMMENT=false
BILI_LIFE_LIKE_DAILY=18
BILI_LIFE_COLLECT_DAILY=9
BILI_LIFE_FOLLOW_DAILY=3
BILI_LIFE_COMMENT_DAILY=4
# 收藏夹 ID；0 = 自动找/建「本鱼想回看」私密收藏夹
BILI_LIFE_FAV_FOLDER_ID=0
BILI_LIFE_TELL_DAILY=1
